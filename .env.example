# Copy this file to .env.local for local development (.env.local is gitignored),
# and add the same two variables in Vercel -> Project -> Settings -> Environment Variables.
#
# The URL and publishable key are safe to expose to the browser. The service-role key is
# server-only and must never be exposed to the browser or committed.

# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only compatibility value for the existing admin client.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> the secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiter variables (server-only)
LIMITER_KV_REST_API_URL=
LIMITER_KV_REST_API_TOKEN=

# Add these URLs in Supabase Dashboard -> Authentication -> URL Configuration
# under Redirect URLs (the app selects the current browser origin automatically):
# http://localhost:3000/auth/callback
# https://your-production-domain.com/auth/callback
