# Copy this file to .env.local for local development (.env.local is gitignored),
# and add the same two variables in Vercel -> Project -> Settings -> Environment Variables.
#
# Both are SERVER-ONLY secrets. Never prefix them with NEXT_PUBLIC_ and never commit real values.

# Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> the secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=
