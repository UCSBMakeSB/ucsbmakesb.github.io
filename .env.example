# Copy this file to .env.local for local development (.env.local is gitignored),
# and add the same two variables in Vercel -> Project -> Settings -> Environment Variables.
#
# The URL and anon key are safe to expose to the browser. The service-role key is
# server-only and must never be exposed to the browser or committed.

# Supabase dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> publishable / anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only compatibility value for the existing admin client.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> the secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=
